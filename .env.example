# --- IA (Google Gemini) ---
GEMINI_API_KEY=

# --- Seguridad (obligatorias en producción) ---
# Secreto para firmar tokens de acceso. Mínimo 32 caracteres aleatorios:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Códigos VIP válidos, separados por coma (mínimo 6 caracteres cada uno).
# Sin esta variable no se acepta ningún código.
ACCESS_CODES=
# Dominios propios autorizados para llamar a /api/* (los de Vercel se añaden solos).
ALLOWED_ORIGINS=https://tu-dominio.com

# --- Rate limiting persistente (recomendado en Vercel) ---
# Base Redis gratuita en https://upstash.com. Sin ellas el límite es por instancia.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Destino de leads (al menos uno; si ambos fallan el cliente reintenta) ---
GOOGLE_SHEETS_WEBHOOK_URL=
CRM_WEBHOOK_URL=
